# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ipynb_checkpoints/
.vscode/

# Model weights / checkpoints / parameters (large binaries, not committed)
*.pt
*.pth
*.pth.tar
*.npz
*.ckpt

# Structural outputs
*.pdb
*.pkl

# Local machine config (copy from config/env_config.json.template, keep private)
config/env_config.json

# Run outputs (only the two curated examples below are versioned)
outputs/*
!outputs/8CRJ_8CRI/
!outputs/8CRJ_8CRI/*.json
!outputs/8CRJ_8CRI/*.pdb
!outputs/8CRJ_8CRI/predictions/
!outputs/8CRJ_8CRI/predictions/*.pdb
!outputs/6HKR_7OXW/
!outputs/6HKR_7OXW/*.json
!outputs/6HKR_7OXW/*.pdb
!outputs/6HKR_7OXW/predictions/
!outputs/6HKR_7OXW/predictions/*.pdb

# OpenFold parameters (5.6 GB, download separately)
openfold/openfold/resources/params/

# Misc
*.log
.DS_Store
